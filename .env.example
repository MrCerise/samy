# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
PORT=4000

# --- Discord ---
DISCORD_TOKEN=
# Leave empty for Discord-recommended shard count, or set a fixed number (e.g. 2).
TOTAL_SHARDS=

# --- Database ---
DATABASE_URL=postgres://samy:samy123@postgres:5432/samy

# --- Third-party APIs ---
LASTFM_API_KEY=

# --- Bot config ---
# Default command prefix used in non-development environments.
DEFAULT_PREFIX=,

# Comma-separated Discord user IDs considered bot devs.
DEVS=1041378399005978624,817404369838276618

# Comma-separated guild IDs used as dev guilds for slash command registration.
DEV_GUILDS=1233555772521320458

# Invite link for the support server shown in error messages.
SUPPORT_INVITE=https://discord.gg/SBx3mn4r8e

# Default per-user command cooldown in seconds.
DEFAULT_COOLDOWN=3

# Discord presence status: online | idle | dnd | invisible
PRESENCE_STATUS=online

# Discord presence browser identifier: Discord Desktop | Discord Android | Discord iOS
PRESENCE_BROWSER=Discord Android

# --- Docker (only used by docker-compose.yaml) ---
POSTGRES_USER=samy
POSTGRES_PASSWORD=samy123
POSTGRES_DB=samy