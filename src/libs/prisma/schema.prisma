generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id

  locale String?

  prefix String?

  timezone String?
  birthday DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastfm LastFM?
  afks   Afk[]
}

model LastFM {
  id String @id @default(cuid())

  username String

  connectedAt DateTime @default(now())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Guild {
  id String @id

  locale String?

  prefix String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  welcomes        Welcome[]
  leaves          Leave[]
  commandSettings CommandSetting[]
  afks            Afk[]
}

model CommandSetting {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  command String

  enabled Boolean @default(true)

  @@unique([guildId, command])
  @@index([guildId])
}

model Welcome {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  channelId String

  message String @db.Text()

  @@unique([guildId, channelId])
  @@index([guildId])
  @@index([channelId])
}

model Leave {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  channelId String

  message String @db.Text()

  @@unique([guildId, channelId])
  @@index([guildId])
  @@index([channelId])
}

model Afk {
  id String @id @default(cuid())

  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason    String
  createdAt DateTime @default(now())

  @@unique([userId, guildId])
  @@index([guildId])
}
